<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration PUBLIC "-//mybatis.org//DTD Config 3.0//EN" "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <settings>
        <!-- DB의 snake_case 컬럼명을 Java의 camelCase 필드명에 자동 매핑 -->
        <setting name="mapUnderscoreToCamelCase" value="true"/>
    </settings>

    <!-- 환경 설정: DB 접속 정보를 나중에 자바 코드에서 주입-->
    <environments default="development">
        <environment id="development">
            <transactionManager type="JDBC"/>
            <dataSource type="POOLED">
                <property name="driver" value="org.postgresql.Driver"/>
                <property name="url" value="jdbc:postgresql://${db.host}:${db.port}/${db.name}"/>
                <property name="username" value="${db.user}"/>
                <property name="password" value="${db.password}"/>
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <mapper class="com.team.orderapp.product.ProductDao"/>
        <mapper class="com.team.orderapp.product.CategoryDao"/>
        <mapper class="com.team.orderapp.product.ProductUnitDao"/>
        <mapper class="com.team.orderapp.customer.CustomerDao"/>
        <mapper class="com.team.orderapp.auth.AppUserDao"/>
        <mapper class="com.team.orderapp.stock.StockAdjustmentDao"/>
        <mapper class="com.team.orderapp.report.ReportDao"/>
        <mapper class="com.team.orderapp.cart.CartDao"/>
        <mapper class="com.team.orderapp.order.query.OrderQueryDao"/>
    </mappers>
</configuration>